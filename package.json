{
  "name": "zen-edge",
  "version": "2.2.1",
  "description": "Zen Edge - Windows 10/11 için donanım hızlandırmalı Mica & iOS Cam efektli, yerel klasör/dosya gezginli, bölünmüş görünümlü (Split-View), dahili reklam engelleyicili ve 0-RAM yerel mini araçlı akıllı masaüstü kenar çubuğu",
  "author": "Serkan ŞENTÜRK (sL.)",
  "repository": {
    "type": "git",
    "url": "https://github.com/836982756578/Zen-Edge.git"
  },
  "homepage": "https://github.com/836982756578/Zen-Edge",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "smoke-test": "electron . --smoke-test",
    "dist:portable": "npx electron-builder --win portable",
    "dist:installer": "npx electron-builder --win nsis",
    "dist": "npx electron-builder --win portable nsis"
  },
  "keywords": [
    "zen-edge",
    "sidebar",
    "edge-bar",
    "kenar-cubugu",
    "folder-explorer",
    "windows-11",
    "mica",
    "acrylic",
    "split-view",
    "adblock",
    "electron",
    "whatsapp-sidebar",
    "desktop-widget"
  ],
  "license": "MIT",
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "electron": "^35.0.0"
  },
  "build": {
    "appId": "com.zenedge.desktop",
    "productName": "Zen Edge",
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "Zen-Edge-Portable-${version}.exe"
    },
    "nsis": {
      "artifactName": "Zen-Edge-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
